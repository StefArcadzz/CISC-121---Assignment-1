# CyclicRotation 1
def solution(A, K):
    # empty list, nothing to do
    if not A:
        return A

    # rotating a full lap changes nothing
    k = K % len(A)
    if k == 0:
        return A[:]

    # last k items go to the front
    return A[-k:] + A[:-k]

# OddOccurrencesInArray 2
def solution(A):
    result = 0
    for value in A:
        # same numbers cancel out
        result ^= value
    # the odd one is left
    return result

# FrogJmp 3
def solution(X, Y, D):
    # distance to travel
    distance = Y - X
    # jumps needed, rounded up
    return -(-distance // D)

# PermMissingElem 4
def solution(A):
    n = len(A) + 1
    # check each number
    for i in range(1, n + 1):
        # found the missing one
        if i not in A:
            return i

# TapeEquilibrium 5
def solution(A):
    total = sum(A)
    left = 0
    best = float("inf")

    # try each split
    for i in range(len(A) - 1):
        left += A[i]
        right = total - left
        # keep the smallest difference
        best = min(best, abs(left - right))

    return best
